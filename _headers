# Cloudflare Pages headers, for the site as tools/build_site.mjs builds it.
#
# assets/ holds the bundled scripts and the copies of data/, every one under a
# name made from a hash of its content: a file there never changes, so browsers
# and the edge keep it for good and a return visit asks for nothing but the
# page.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else can change with any deploy, the page above all: it is what
# names the current assets. js/ and data/ are the unbundled tree, which the
# built page does not load from (the test hosts under test/ do); its page AND
# worker modules must never be served as a mixed old/new set -- workers skip
# hard-refresh revalidation, so a cached module from a previous deploy silently
# breaks overlays / pixel scenes / edge decals (same failure mode
# tools/dev_server.py exists to prevent locally). no-cache still allows 304
# revalidation.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/data/*
  Cache-Control: no-cache
